@@ -5,6 +7,122 @@ import { loadCommentShortcuts } from "./shortcuts.js";
 import { hasExactSubmoduleRange } from "./types.js";
 import { runReviewApp } from "./ui/review-app.js";
 
+interface ReviewWindowData {
+  repoRoot: string;
+  files: Awaited<ReturnType<typeof getReviewWindowData>>["files"];
+}
+
+interface RepoCandidate {
+  repoRoot: string;
+  count: number;
+}
+
+function getPathDirectory(path: string): string {
+  try {
+    if (existsSync(path) && statSync(path).isDirectory()) return path;
+  } catch {
+    // Fall through to dirname for inaccessible paths.
+  }
+
+  return dirname(path);
+}
+
+function getSessionModifiedPaths(ctx: ExtensionContext): string[] {
+  const paths: string[] = [];
+
+  for (const entry of ctx.sessionManager.getBranch() as any[]) {
+    if ((entry.type === "compaction" || entry.type === "branch_summary") && Array.isArray(entry.details?.modifiedFiles)) {
+      for (const path of entry.details.modifiedFiles) {
+        if (typeof path === "string" && path.length > 0) paths.push(path);
+      }
+    }
+
+    if (entry.type !== "message" || entry.message?.role !== "assistant" || !Array.isArray(entry.message.content)) continue;
+
+    for (const block of entry.message.content) {
+      if (block?.type !== "toolCall") continue;
+      if (block.name !== "edit" && block.name !== "write") continue;
+      const path = block.arguments?.path;
+      if (typeof path === "string" && path.length > 0) paths.push(path);
+    }
+  }
+
+  return paths;
+}
+
+async function findGitRoot(pi: ExtensionAPI, startPath: string): Promise<string | null> {
+  let cwd = getPathDirectory(startPath);
+
+  while (true) {
+    const result = await pi.exec("git", ["rev-parse", "--show-toplevel"], { cwd });
+    if (result.code === 0) {
+      const repoRoot = result.stdout.trim();
+      if (repoRoot.length > 0) return repoRoot;
+    }
+
+    const parent = dirname(cwd);
+    if (parent === cwd || parse(cwd).root === cwd) return null;
+    cwd = parent;
+  }
+}
+
+async function getSessionRepoCandidates(pi: ExtensionAPI, ctx: ExtensionContext): Promise<RepoCandidate[]> {
+  const counts = new Map<string, number>();
+  const seenPaths = new Set<string>();
+
+  for (const rawPath of getSessionModifiedPaths(ctx)) {
+    const absolutePath = isAbsolute(rawPath) ? rawPath : resolve(ctx.cwd, rawPath);
+    if (seenPaths.has(absolutePath)) continue;
+    seenPaths.add(absolutePath);
+
+    const repoRoot = await findGitRoot(pi, absolutePath);
+    if (repoRoot == null) continue;
+    counts.set(repoRoot, (counts.get(repoRoot) ?? 0) + 1);
+  }
+
+  return [...counts.entries()]
+    .map(([repoRoot, count]) => ({ repoRoot, count }))
+    .sort((a, b) => b.count - a.count || a.repoRoot.localeCompare(b.repoRoot));
+}
+
+async function getReviewDataIfAvailable(pi: ExtensionAPI, cwd: string): Promise<ReviewWindowData | null> {
+  try {
+    const data = await getReviewWindowData(pi, cwd);
+    return data.files.length > 0 ? data : null;
+  } catch {
+    return null;
+  }
+}
+
+async function chooseInferredReviewData(pi: ExtensionAPI, ctx: ExtensionContext): Promise<ReviewWindowData | null> {
+  const candidates = await getSessionRepoCandidates(pi, ctx);
+  const reviewable: Array<RepoCandidate & { data: ReviewWindowData }> = [];
+
+  for (const candidate of candidates) {
+    const data = await getReviewDataIfAvailable(pi, candidate.repoRoot);
+    if (data != null) reviewable.push({ ...candidate, data });
+  }
+
+  if (reviewable.length === 0) return null;
+  if (reviewable.length === 1 || !ctx.hasUI) return reviewable[0].data;
+
+  const labels = reviewable.map((candidate) => `${candidate.repoRoot} (${candidate.count} session change${candidate.count === 1 ? "" : "s"})`);
+  const selected = await ctx.ui.select("Choose repository to review", labels);
+  if (selected == null) return null;
+
+  const selectedIndex = labels.indexOf(selected);
+  return selectedIndex >= 0 ? reviewable[selectedIndex].data : null;
+}
+
+async function resolveReviewData(pi: ExtensionAPI, ctx: ExtensionContext, args: string): Promise<ReviewWindowData | null> {
+  const target = args.trim();
+  if (target.length > 0) {
+    return getReviewDataIfAvailable(pi, isAbsolute(target) ? target : resolve(ctx.cwd, target));
+  }
+
+  return (await getReviewDataIfAvailable(pi, ctx.cwd)) ?? chooseInferredReviewData(pi, ctx);
+}
